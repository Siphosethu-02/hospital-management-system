# .env.example (project root)
# Copy this to `.env` in the project root before running `docker compose up`.
# docker-compose.yml reads this file automatically (it looks for `.env`
# next to itself) and substitutes these values into every service that
# references ${VARIABLE_NAME}. Every variable has a safe default baked
# into docker-compose.yml too, so the stack will start even without a
# .env file - but you should still create one and change the secrets
# before using this anywhere beyond your own machine.
#
# This file is separate from client/.env.example and server/.env.example,
# which are for running the frontend/backend directly on your machine
# WITHOUT Docker. Docker Compose does not read those.

# ==========================================
# MYSQL
# ==========================================
DB_ROOT_PASSWORD=root_change_me
DB_NAME=hospital_management_system
DB_USER=hms_user
DB_PASSWORD=hms_password_change_me

# Host port MySQL is published on. Change this if you already have a
# local MySQL using 3306.
DB_HOST_PORT=3306

# ==========================================
# JWT / AUTHENTICATION (backend)
# ==========================================
# Generate real secrets with: openssl rand -hex 64
JWT_ACCESS_SECRET=dev_access_secret_please_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_please_change_me
COOKIE_SECRET=dev_cookie_secret_please_change_me

# ==========================================
# DEFAULT ADMIN ACCOUNT
# ==========================================
# Created automatically on first boot by the backend's entrypoint
# (server/database/seed.js). Change the password immediately after
# your first login.
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ==========================================
# URLS (used for CORS + the browser-facing API base URL)
# ==========================================
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api/v1

# ==========================================
# PHPMYADMIN
# ==========================================
PHPMYADMIN_PORT=8080

# ==========================================
# PRODUCTION ONLY (docker-compose.prod.yml)
# ==========================================
# Not used by the local dev stack (docker-compose.yml) - only read when
# running `docker compose -f docker-compose.prod.yml up --build -d`.
#
# DOMAIN: your real domain name pointed at this server's public IP
# (an A record), e.g. hms.example.com - Caddy uses this to automatically
# obtain and renew a free HTTPS certificate from Let's Encrypt. No
# domain yet? Set this to ":80" instead to test over plain HTTP on a
# bare IP first (see the comment at the top of client/Caddyfile).
DOMAIN=hms.example.com

# PUBLIC_URL: the full public URL patients/staff will actually use -
# should match DOMAIN with a scheme, e.g. https://hms.example.com (or
# http://YOUR_SERVER_IP if you're using DOMAIN=:80 for now).
PUBLIC_URL=https://hms.example.com
