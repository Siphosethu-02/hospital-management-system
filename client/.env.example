# client/.env.example
# Copy this to client/.env and fill in your Firebase project's config
# values. Find them at: Firebase Console -> Project Settings (gear icon)
# -> General tab -> "Your apps" -> your web app -> SDK setup and
# configuration -> Config.
#
# These values are NOT secrets - they identify your project to
# Firebase's client SDK, the same way a database hostname isn't a
# password. Real access control lives entirely in firestore.rules, not
# in keeping these hidden. See:
# https://firebase.google.com/docs/projects/api-keys

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
